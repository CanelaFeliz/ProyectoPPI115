        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    CATEGORIAS {\n        int id_categoria PK\n        varchar nombre_categoria\n    }\n\n    PRODUCTOS {\n        int id_producto PK\n        varchar nombre_producto\n        varchar descripcion\n        varchar fotografia\n        decimal precio\n        varchar estado_disponibilidad\n        int id_categoria FK\n    }\n\n    MESAS {\n        int id_mesa PK\n        int numero_mesa\n        varchar estado_mesa\n    }\n\n    ROLES {\n        int id_rol PK\n        varchar nombre_rol\n    }\n\n    USUARIOS {\n        int id_usuario PK\n        varchar nombre_completo\n        varchar nombre_usuario\n        varchar contrasena\n        int id_rol FK\n    }\n\n    PEDIDOS {\n        int id_pedido PK\n        datetime fecha_hora\n        varchar estado_pedido\n        decimal porcentaje_propina\n        decimal total_pagar\n        varchar metodo_pago\n        int id_mesa FK\n        int id_usuario FK\n    }\n\n    DETALLE_PEDIDOS {\n        int id_detalle PK\n        int cantidad\n        decimal subtotal\n        int id_pedido FK\n        int id_producto FK\n    }\n\n    INVENTARIOS {\n        int id_ingrediente PK\n        varchar nombre_ingrediente\n        decimal cantidad_estimada\n    }\n\n    RECETAS {\n        int id_receta PK\n        decimal cantidad_necesaria\n        int id_producto FK\n        int id_ingrediente FK\n    }\n\n    CATEGORIAS ||--o{ PRODUCTOS : clasifica\n    ROLES ||--o{ USUARIOS : agrupa\n    MESAS ||--o{ PEDIDOS : registra\n    USUARIOS ||--o{ PEDIDOS : realiza\n    PEDIDOS ||--o{ DETALLE_PEDIDOS : contiene\n    PRODUCTOS ||--o{ DETALLE_PEDIDOS : incluye\n    PRODUCTOS ||--o{ RECETAS : utiliza\n    INVENTARIOS ||--o{ RECETAS : contiene&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="jXZfqhlYS-tAy1UnurK5-1">
