        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;---\nconfig:\n  theme: default\n  layout: dagre\n---\nerDiagram\n    CATEGORIAS {\n        INT id_categoria PK\n        VARCHAR nombre_categoria\n    }\n    \n    PRODUCTOS {\n        INT id_producto PK\n        VARCHAR nombre_producto\n        VARCHAR descripcion\n        VARCHAR fotografia\n        DECIMAL precio\n        VARCHAR estado_disponibilidad\n        INT id_categoria FK\n    }\n    \n    MESAS {\n        INT id_mesa PK\n        INT numero_mesa\n        VARCHAR estado_mesa\n        INT capacidad\n    }\n    \n    ROLES {\n        INT id_rol PK\n        VARCHAR nombre_rol\n    }\n    \n    USUARIOS {\n        INT id_usuario PK\n        VARCHAR nombre_completo\n        VARCHAR nombre_usuario\n        VARCHAR contrasena\n        INT id_rol FK\n    }\n    \n    PEDIDOS {\n        INT id_pedido PK\n        DATETIME fecha_hora\n        VARCHAR estado_pedido\n        DECIMAL porcentaje_propina\n        DECIMAL total_pagar\n        VARCHAR metodo_pago\n        INT id_mesa FK \&quot;NULL\&quot;\n        INT id_usuario FK \&quot;NULL\&quot;\n        VARCHAR nombre_cliente\n        VARCHAR apellido_cliente\n        VARCHAR telefono_cliente\n        VARCHAR correo_cliente\n        VARCHAR tipo_orden\n        VARCHAR municipio\n        VARCHAR direccion\n        VARCHAR punto_referencia\n        DECIMAL monto_abonado\n        DECIMAL saldo_pendiente\n    }\n    \n    DETALLE_PEDIDOS {\n        INT id_detalle PK\n        INT cantidad\n        DECIMAL subtotal\n        INT id_pedido FK\n        INT id_producto FK\n    }\n    \n    INVENTARIOS {\n        INT id_ingrediente PK\n        VARCHAR nombre_ingrediente\n        DECIMAL cantidad_estimada\n    }\n    \n    RECETAS {\n        INT id_receta PK\n        DECIMAL cantidad_necesaria\n        INT id_producto FK\n        INT id_ingrediente FK\n    }\n\n    CATEGORIAS ||--o{ PRODUCTOS : \&quot;clasifica\&quot;\n    ROLES ||--o{ USUARIOS : \&quot;agrupa\&quot;\n    MESAS ||--o{ PEDIDOS : \&quot;registra\&quot;\n    USUARIOS ||--o{ PEDIDOS : \&quot;realiza\&quot;\n    PEDIDOS ||--o{ DETALLE_PEDIDOS : \&quot;contiene\&quot;\n    PRODUCTOS ||--o{ DETALLE_PEDIDOS : \&quot;incluye\&quot;\n    PRODUCTOS ||--o{ RECETAS : \&quot;utiliza\&quot;\n    INVENTARIOS ||--o{ RECETAS : \&quot;contiene\&quot;&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="G43rzsZ59BuvrE8Mgdx7-237">
