        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;---\nconfig:\n  theme: default\n  layout: dagre\n---\ngraph TD\n    A([Inicia proceso]) --&gt; B(Cliente: Explora los productos listados en el menú web)\n    B --&gt; C(Cliente: Selecciona un producto de su interés)\n    C --&gt; D{Sistema: Valida el estado de disponibilidad del producto}\n    D -- Producto con estado disponible --&gt; E(Sistema: Consulta en la base de datos la información asociada a ese producto)\n    D -- Producto pasó a estado inactivo/sin disponibilidad --&gt; F(Sistema: Muestra mensaje indicando que el artículo ya no se encuentra disponible y refresca el catálogo)\n    E --&gt; G(Sistema: Renderiza la fotografía, descripción y precio en pantalla para el usuario)\n    G --&gt; H(Cliente visualiza la información)\n    F --&gt; I([Fin del flujo alternativo])\n    H --&gt; I&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="2xGL-y6yMCa911G7TMcO-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
