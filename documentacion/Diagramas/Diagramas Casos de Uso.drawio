  <diagram id="ZVxlHPsDaRlmubm4Rnbn" name="RF16">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1200" pageHeight="1600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;---\nconfig:\n  theme: default\n  layout: dagre\n---\ngraph TD\n    A([Inicio]) --&gt; B(Cajero: Ingresa al módulo de recepción de pedidos web)\n    B --&gt; C(Sistema: Muestra una tabla de control dinámica listando los pedidos web entrantes)\n    C --&gt; D(Cajero: Acciona los botones de filtro para segmentar las vistas entre \&quot;Envío a domicilio\&quot; y \&quot;Retiro en el local\&quot;)\n    D --&gt; E{¿Existen pedidos que coincidan con el filtro?}\n    E -- Sí --&gt; F(Sistema: Actualiza la lista mostrando únicamente los pedidos que coincidan con el filtro seleccionado)\n    F --&gt; G(Cajero: Selecciona un pedido a domicilio específico para ver sus detalles)\n    G --&gt; H(Sistema: Despliega un panel lateral con la información logística del cliente y botones para actualizar el estado del ciclo de entrega)\n    E -- No --&gt; I(Sistema: Mostrará un mensaje indicando que la bandeja de entrada está vacía para esa categoría)\n    H --&gt; J([Fin])\n    I --&gt; J&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="_VjrJ2159nUg4O07uGOl-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
