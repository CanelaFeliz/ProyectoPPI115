        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;stateDiagram-v2\n    [*] --&gt; IngresarGestion: Inicia proceso\n\n    state \&quot;Administrador: Ingresa a la opción de gestión de mesas en su panel\&quot; as IngresarGestion\n    state \&quot;Sistema: Muestra la lista de mesas actuales y habilita la opción de agregar una nueva\&quot; as MostrarMesas\n    state \&quot;Administrador: Ingresa los datos correspondientes a la nueva mesa y guarda los cambios\&quot; as IngresarDatos\n    state \&quot;Sistema: Valida la unicidad del número o identificador de la mesa\&quot; as ValidarMesa\n    state \&quot;Sistema: Registra la mesa en la base de datos, actualiza el listado y la habilita\&quot; as RegistrarMesa\n    state \&quot;Sistema: Bloquea el registro y muestra un mensaje de error solicitando un número único\&quot; as MostrarError\n\n    IngresarGestion --&gt; MostrarMesas\n    MostrarMesas --&gt; IngresarDatos\n    IngresarDatos --&gt; ValidarMesa\n\n    ValidarMesa --&gt; RegistrarMesa: [Número de mesa único]\n    ValidarMesa --&gt; MostrarError: [Número de mesa ya existe]\n\n    RegistrarMesa --&gt; [*]: Mesa registrada y disponible\n    MostrarError --&gt; [*]: Fin del flujo alternativo&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="BQjW8H_c-Dr6AroiTQ9S-1">
