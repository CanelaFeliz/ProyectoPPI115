  <diagram id="MDLmvgeYEvTpeE9dM4tc" name="RF02">
    <mxGraphModel dx="2102" dy="1147" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1600" math="0" shadow="0">
      <root>
