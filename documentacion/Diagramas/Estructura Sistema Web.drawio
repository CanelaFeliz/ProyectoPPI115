                <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    Root[Sistema Web para&lt;br/&gt;Administración de una Cafetería]:::root\n\n    Root --&gt; C_Role(Interfaz Pública -&lt;br/&gt;Rol: Cliente):::cliente\n    Root --&gt; S_Role(Panel Operativo - Rol:&lt;br/&gt;Personal de Servicio / Cajero):::servicio\n    Root --&gt; A_Role(Panel de Administración -&lt;br/&gt;Rol: Administrador):::admin\n\n    %% Rama Cliente\n    C_Role --&gt; C_Home[Inicio / Página&lt;br/&gt;Principal]:::cliente\n    C_Home --&gt; C_Menu[Menú por&lt;br/&gt;Categorías]:::cliente\n    C_Menu --&gt; C_Detail[Detalle de&lt;br/&gt;Producto]:::cliente\n    C_Menu --&gt; C_Cart[Resumen de Selección&lt;br/&gt;/ Carrito]:::cliente\n    C_Cart --&gt; C_Order[Modal de Datos y Modalidad&lt;br/&gt;Domicilio / Retiro]:::cliente\n    C_Order --&gt; C_Pay[Pago Simulado y&lt;br/&gt;Comprobante PDF]:::cliente\n\n    %% Rama Personal de Servicio / Cajero\n    S_Role --&gt; S_Login[Login /&lt;br/&gt;Autenticación]:::servicio\n    S_Login --&gt; S_Dash[Dashboard del Empleado /&lt;br/&gt;Vista de Mesas]:::servicio\n    S_Dash --&gt; S_Web[Recepción de Pedidos&lt;br/&gt;Web - Cajero]:::servicio\n    S_Dash --&gt; S_Orders[Gestión de&lt;br/&gt;Órdenes]:::servicio\n    S_Dash --&gt; S_Close[Cierre, Cálculo de Saldo&lt;br/&gt;y Ticket PDF]:::servicio\n\n    S_Web --&gt; S_Filter[Filtro Domicilio / Retiro&lt;br/&gt;y Estado de Envío]:::servicio\n    S_Web --&gt; S_Assign[Asignación de Pedido Web&lt;br/&gt;a Mesa Disponible]:::servicio\n\n    S_Orders --&gt; S_Open[Apertura y Modificación&lt;br/&gt;de Cuenta Activa]:::servicio\n    S_Orders --&gt; S_Status[Control de Estado&lt;br/&gt;de Orden]:::servicio\n\n    %% Rama Administrador\n    A_Role --&gt; A_Login[Login /&lt;br/&gt;Autenticación]:::admin\n    A_Login --&gt; A_Dash[Dashboard&lt;br/&gt;Administrativo]:::admin\n    A_Dash --&gt; A_CatMenu[Módulo de Catálogo&lt;br/&gt;y Menú]:::admin\n    A_Dash --&gt; A_Tables[Módulo de&lt;br/&gt;Mesas]:::admin\n    A_Dash --&gt; A_Inv[Módulo de&lt;br/&gt;Inventarios]:::admin\n    A_Dash --&gt; A_Staff[Módulo de Cuentas de&lt;br/&gt;Personal]:::admin\n    A_Dash --&gt; A_Rep[Módulo de Análisis y&lt;br/&gt;Reportes]:::admin\n\n    A_CatMenu --&gt; A_Cat[Gestión de&lt;br/&gt;Categorías]:::admin\n    A_CatMenu --&gt; A_Prod[Gestión de&lt;br/&gt;Productos]:::admin\n\n    classDef root fill:#e8daef,stroke:#9b59b6,stroke-width:1.5px,color:#000\n    classDef cliente fill:#d4efdf,stroke:#27ae60,stroke-width:1.5px,color:#000\n    classDef servicio fill:#d6eaf8,stroke:#2980b9,stroke-width:1.5px,color:#000\n    classDef admin fill:#fcf3cf,stroke:#f39c12,stroke-width:1.5px,color:#000&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="ha_OmLu4lU8kQVDtQyt0-1">
