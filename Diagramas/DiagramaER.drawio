        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n  CATEGORIAS ||--|{ PRODUCTOS : clasifica\n  ROLES ||--|{ USUARIOS : agrupa\n  MESAS ||--o{ PEDIDOS : tiene\n  USUARIOS ||--o{ PEDIDOS : registra\n  PEDIDOS ||--|{ DETALLE_PEDIDOS : contiene\n  PRODUCTOS ||--o{ DETALLE_PEDIDOS : incluye\n  PRODUCTOS ||--|{ RECETAS : compone\n  INVENTARIOS ||--o{ RECETAS : utiliza\n\n  CATEGORIAS {\n    int id_categoria PK\n    string nombre_categoria\n  }\n\n  PRODUCTOS {\n    int id_producto PK\n    string nombre_producto\n    string descripcion\n    string fotografia\n    decimal precio\n    string estado_disponibilidad\n    int id_categoria FK\n  }\n\n  MESAS {\n    int id_mesa PK\n    int numero_mesa\n    string estado_mesa\n  }\n\n  PEDIDOS {\n    int id_pedido PK\n    datetime fecha_hora\n    string estado_pedido\n    decimal porcentaje_propina\n    decimal total_pagar\n    string metodo_pago\n    int id_mesa FK\n    int id_usuario FK\n  }\n\n  USUARIOS {\n    int id_usuario PK\n    string nombre_completo\n    string nombre_usuario\n    string contrasena\n    int id_rol FK\n  }\n\n  INVENTARIOS {\n    int id_ingrediente PK\n    string nombre_ingrediente\n    decimal cantidad_estimada\n  }\n\n  ROLES {\n    int id_rol PK\n    string nombre_rol\n  }\n\n  DETALLE_PEDIDOS {\n    int id_detalle PK\n    int cantidad\n    decimal subtotal\n    int id_pedido FK\n    int id_producto FK\n  }\n\n  RECETAS {\n    int id_receta PK\n    decimal cantidad_necesaria\n    int id_producto FK\n    int id_ingrediente FK\n  }&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="tW7ye0dQH6zYbJ61szug-1">
